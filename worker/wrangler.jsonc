{
	"name": "pulse-checker",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true,
	},
	"triggers": {
		"crons": ["*/5 * * * *"],
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pulse-db",
			"database_id": "PASTE-YOUR-ID-HERE",
		},
	],
}